4-Contagem regressiva e soma
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
       int n;
       int soma = 0;
       n = sc.nextInt();
       
       for (int i = n; i >= 1; i--) {
        soma = soma + i; 
     System.out.print(i + " ");
       }
    System.out.println("\nSoma = " + soma);
    } 
}

