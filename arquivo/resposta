6-Cálculo da série E
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int N;
        double E = 1;
        int fatorial = 1;

        System.out.print("Digite um numero inteiro positivo: ");
        N = sc.nextInt();
        
        for (int i = 1; i <= N; i++) {
            fatorial = 1;
        for (int j = 1; j <= i; j++) {
            fatorial = fatorial * j;
        }
        E = E + 1.0 / fatorial;
       }
       System.out.println("E = " + E);
    }
}

