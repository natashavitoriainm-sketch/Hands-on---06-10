import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        double salario;
        double somaSalarios = 0;
        double maiorSalario = 0;

        int filhos;
        int somaFilhos = 0;
        int quantidade = 0;
        int ate100 = 0;
        
        System.out.print("Digite o salario: ");
