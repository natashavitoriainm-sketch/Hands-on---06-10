6-Cálculo da série E
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int N;
        double E = 1;
        int fatorial = 1;

        System.out.print("Digite um numero inteiro positivo: ");
        N = sc.nextInt();
        
        for (int i = 1; i <= N; i++) {
            fatorial = 1;
        for (int j = 1; j <= i; j++) {
            fatorial = fatorial * j;
        }
        E = E + 1.0 / fatorial;
       }
       System.out.println("E = " + E);
    }
}

7- Pesquisa da Prefeitura
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        double salario;
        double somaSalarios = 0;
        double maiorSalario = 0;

        int filhos;
        int somaFilhos = 0;
        int quantidade = 0;
        int ate100 = 0;
        
        System.out.print("Digite o salario: ");
        salario = sc.nextDouble();
        
        while (salario >= 0) {
            System.out.print("Digite o numero de filhos: ");
            filhos = sc.nextInt();
            
            somaSalarios = somaSalarios + salario;
            somaFilhos = somaFilhos + filhos;
            quantidade++;
            if (salario <= 100) {
                ate100++;
            }
            if (salario > maiorSalario) {
                maiorSalario = salario;
            }
            System.out.print("Digite o salario (negativo para encerrar): ");
            salario = sc.nextDouble();
        }
        double mediaSalaria = 0;
        double mediaFilhos = 0;
        double percentual = 0;
        
        if (quantidade > 0) {
         mediaSalaria = somaSalarios / quantidade;
         mediaFilhos = (double) somaFilhos / quantidade;    
         percentual = ate100 * 100.0 / quantidade;   
        
        System.out.println("A média salarial da população: " + mediaSalaria);
        System.out.println("A média salarial dos filhos: " + mediaFilhos);
        System.out.println("O maior salario: " + maiorSalario);
        System.out.println("Percentual: " + percentual);
        }
    }
}

