public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int maiorNum;
        int menorNum;
    
        System.out.print("Informe um numero ou 0 para encerrar: ");
        int numero = sc.nextInt();
        
         if (numero != 0) {
         maiorNum = numero;
         menorNum = numero;
        
         while (numero != 0) {    
        if (numero > maiorNum) {
         maiorNum = numero;
        }
        if (numero < menorNum) {
         menorNum = numero;
        }
        System.out.print("Informe um numero ou 0 para encerrar: ");
        numero = sc.nextInt(); 
         }
         System.out.println("Maior número: " + maiorNum);
