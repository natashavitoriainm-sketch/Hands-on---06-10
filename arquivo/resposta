import java.util.Scanner;
public class Main {
	public static void main(String[] args) {
	
	Scanner sc = new Scanner(System.in);

        int i = 1;

        double preco;
        double custoEstocagem;
        double imposto;
        double precoFinal;

        double somaAdicionais = 0;
        double totalImpostos = 0;
        double maiorPrecoFinal = 0;
        double menorPrecoFinal = 0;

        int baratos = 0;
        int normais = 0;
        int caros = 0;

        char refrigeracao;
        char categoria;
        String classificacao;

        while (i <= 12) {

        System.out.println("\n------PRODUTO " + i + " ------");

        System.out.print("Digite o preço unitário: R$ ");
        preco = sc.nextDouble();

        System.out.print("Precisa de refrigeração? (S/N): ");
        refrigeracao = sc.next().toUpperCase().charAt(0);

        System.out.print("Categoria (A/L/V): ");
        categoria = sc.next().toUpperCase().charAt(0);
	
    if (preco <= 20) {

    if (categoria == 'A') {
     custoEstocagem = 2.00;
    } else if (categoria == 'L') {
     custoEstocagem = 3.00;
    
    } else {
     custoEstocagem = 4.00;
    }

    } else if (preco <= 50) {

    if (refrigeracao == 'S') {
      custoEstocagem = 6.00;
    } else {
      custoEstocagem = 0.00;
    }

    } else {

    if (refrigeracao == 'S') {

    if (categoria == 'A') {
     custoEstocagem = 5.00;
     
    } else if (categoria == 'L') {
     custoEstocagem = 2.00;
            
    } else {
     custoEstocagem = 4.00;
    }

    } else {

    if (categoria == 'L') {
    custoEstocagem = 1.00;
    
    } else {
    custoEstocagem = 0.00;
    
         }
      }
    }
        if (categoria == 'A' && refrigeracao == 'S') {
                imposto = preco * 0.04;
        } else {
                imposto = preco * 0.02;
        }
        
        precoFinal = preco + custoEstocagem + imposto;
        
         if (precoFinal <= 20) {
        classificacao = "Barato";
        baratos++;
        
        } else if (precoFinal <= 100) {
        classificacao = "Normal";
        normais++;
        
        } else {
        classificacao = "Caro";
        caros++;
        }
        
        somaAdicionais += custoEstocagem + imposto;
        totalImpostos += imposto;
        
        if (i == 1) {
        maiorPrecoFinal = precoFinal;
        menorPrecoFinal = precoFinal;
        
        } else {
        if (precoFinal > maiorPrecoFinal) {
        maiorPrecoFinal = precoFinal;
        }

        if (precoFinal < menorPrecoFinal) {
        menorPrecoFinal = precoFinal;
          }
        }
        System.out.printf("Preço unitário: R$ %.2f%n", preco);
        System.out.printf("Custo de estocagem: R$ %.2f%n",
        custoEstocagem);
        
        System.out.printf("Imposto: R$ %.2f%n", imposto);
        System.out.printf("Preço final: R$ %.2f%n", precoFinal);
        System.out.println("Classificação: " + classificacao);

        i++;
        }
        
        double mediaAdicionais = somaAdicionais / 12;

        System.out.printf("Média dos valores adicionais: R$ %.2f%n",
                mediaAdicionais);
        System.out.printf("Maior preço final: R$ %.2f%n",
                maiorPrecoFinal);
        System.out.printf("Menor preço final: R$ %.2f%n",
                menorPrecoFinal);
        System.out.printf("Total de impostos: R$ %.2f%n",
                totalImpostos);

        System.out.println("Produtos baratos: " + baratos);
        System.out.println("Produtos normais: " + normais);
        System.out.println("Produtos caros: " + caros);
    
    }
  }
